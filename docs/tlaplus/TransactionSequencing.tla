---- MODULE TransactionSequencing ----
EXTENDS Integers, Sequences, FiniteSets, TLC

CONSTANTS Lists

VARIABLES
    clientCard,     \* Current list of the card on client
    clientSeq,      \* Current sequence number generated by client
    lastAckSeq,     \* Last acknowledged sequence number
    network,        \* Set of response messages in flight
    useSeqGuard     \* Boolean flag: TRUE = with monotonic sequence guard, FALSE = without

vars == <<clientCard, clientSeq, lastAckSeq, network, useSeqGuard>>

Init ==
    /\ clientCard = "L1"
    /\ clientSeq = 0
    /\ lastAckSeq = 0
    /\ network = {}
    /\ useSeqGuard \in {TRUE, FALSE}

InitNoGuard ==
    /\ clientCard = "L1"
    /\ clientSeq = 0
    /\ lastAckSeq = 0
    /\ network = {}
    /\ useSeqGuard = FALSE

InitWithGuard ==
    /\ clientCard = "L1"
    /\ clientSeq = 0
    /\ lastAckSeq = 0
    /\ network = {}
    /\ useSeqGuard = TRUE

\* User performs Drag 1 (to L2) then Drag 2 (to L3) in quick succession
DragOne ==
    /\ clientSeq = 0
    /\ clientSeq' = 1
    /\ clientCard' = "L2"
    /\ network' = network \union {[seq |-> 1, targetList |-> "L2"]}
    /\ UNCHANGED <<lastAckSeq, useSeqGuard>>

DragTwo ==
    /\ clientSeq = 1
    /\ clientSeq' = 2
    /\ clientCard' = "L3"
    /\ network' = network \union {[seq |-> 2, targetList |-> "L3"]}
    /\ UNCHANGED <<lastAckSeq, useSeqGuard>>

\* Client receives a response from the network (network can deliver in ANY order!)
ClientReceiveResp ==
    /\ \E msg \in network :
         /\ network' = network \ {msg}
         /\ IF useSeqGuard
            THEN
              \* WITH GUARD: drop stale response if seq <= lastAckSeq
              IF msg.seq > lastAckSeq
              THEN
                /\ lastAckSeq' = msg.seq
                /\ clientCard' = msg.targetList
              ELSE
                /\ UNCHANGED <<lastAckSeq, clientCard>>
            ELSE
              \* WITHOUT GUARD: blindly apply whatever response arrives (causes flicker / stale overwrite)
              /\ clientCard' = msg.targetList
              /\ lastAckSeq' = msg.seq
         /\ UNCHANGED <<clientSeq, useSeqGuard>>

Next ==
    \/ DragOne
    \/ DragTwo
    \/ ClientReceiveResp

\* Invariant: No Stale Overwrite
\* Once DragTwo has completed (seq 2 reached) and network has cleared, card MUST be in L3!
NoStaleOverwrite ==
    (clientSeq = 2 /\ network = {}) => clientCard = "L3"

Spec == Init /\ [][Next]_vars
====
